# Copy this file to backend/.env and adjust as needed.
# No paid API keys are required anywhere in this file — see API_SETUP_GUIDE.md
# for the one genuinely optional integration (none are required to run this).

APP_ML_DIR=../ml
APP_ML_CONFIG_PATH=../ml/configs/config.yaml

# Point this at your trained checkpoint once you have one:
#   APP_MODEL_WEIGHTS=../ml/runs/train/tumor_yolo11/weights/best.pt
# Until then it defaults to a stock (non-tumor-tuned) YOLOv11n checkpoint so
# the API is explorable end-to-end.
APP_MODEL_WEIGHTS=../ml/yolo11n.pt

APP_STORAGE_DIR=./storage
APP_CONF_THRES=0.35
APP_IOU_THRES=0.45

APP_DATABASE_URL=sqlite:///./storage/app.db

# Comma-separated list — add your deployed frontend origin(s) in production
APP_CORS_ORIGINS=["http://localhost:3000"]

APP_MAX_UPLOAD_MB=20
